{
  "name": "grandmaster-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "engines:patricia": "node engines/patricia/build.mjs",
    "engines:stockfish": "node scripts/copy-stockfish.mjs",
    "data": "python scripts/gen-data.py",
    "icons": "node scripts/gen-icons.mjs",
    "test": "node scripts/run-ts.mjs tests/polyglot.test.ts && node scripts/run-ts.mjs tests/drawfish.test.ts && node scripts/run-ts.mjs tests/game-pgn.test.ts && node scripts/run-ts.mjs tests/settings.test.ts && node scripts/run-ts.mjs tests/host-sync.test.ts && node scripts/engine-smoke.mjs",
    "typecheck": "tsc -b",
    "book": "node scripts/run-ts.mjs scripts/build-book.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.4.2",
    "@preact/signals": "^2.11.3",
    "chessops": "^0.15.1",
    "preact": "^11.0.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "stockfish": "19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
